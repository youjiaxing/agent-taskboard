{
  "name": "agent-taskboard-desktop",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:app": "node scripts/dev-app.mjs",
    "build": "tsc && vite build",
    "build:acceptance": "node scripts/acceptance-manifest.mjs build",
    "acceptance:manifest": "node scripts/acceptance-manifest.mjs generate",
    "acceptance:verify": "node scripts/acceptance-manifest.mjs verify",
    "test": "node --test --experimental-strip-types scripts/*.test.ts",
    "verify:ui-contracts": "node scripts/verify-ui-contracts.mjs",
    "verify:release": "npm test && npm run verify:ui-contracts && node scripts/verify-release.mjs",
    "release": "node scripts/release.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
