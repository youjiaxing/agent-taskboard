{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Taskboard",
  "version": "0.1.0",
  "identifier": "com.youjiaxing.agent-taskboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Taskboard",
        "width": 1280,
        "height": 840,
        "minWidth": 880,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "resources": ["../dist"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/minimum-version.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1ODNBOTQ1QjUyMkRBOUMKUldTYzJpSzFSYW1ESlZJS3pzTTBhdzhOZDhud2ZmYTBjMWxkQjM1Uys1cHNLWm1rT0EyYUtKRFQK",
      "endpoints": [
        "https://github.com/youjiaxing/agent-taskboard/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
